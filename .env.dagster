# Quant Dagster Environment Variables
# 复制为 .env 并根据环境修改

# ===== PostgreSQL =====
POSTGRES_PASSWORD=dagster

# ===== Dagster =====
DAGSTER_IMAGE=quant-dagster:latest
DAGSTER_HOME=/opt/dagster/dagster_home

# ===== Quant Config (通过 EnvVar 注入) =====
# Data Source Registry
QUANT_STATE_DIR=/tmp/quant_sources

# Factor Store
QUANT_FACTOR_DB_PATH=quant/data/factor_cache.db

# Trade Repo
QUANT_TRADE_DB_PATH=quant/data/trades.db

# Market DB
QUANT_MARKET_DB_PATH=quant/data/market.db

# Data Sources (Tokens/API Keys)
TUSHARE_TOKEN=your_tushare_token_here
TICKFLOW_API_KEY=your_tickflow_api_key_here

# ===== Optional: External Services =====
# Grafana
GRAFANA_ADMIN_PASSWORD=admin

# Prometheus
PROMETHEUS_RETENTION=30d

# Alertmanager
ALERTMANAGER_CONFIG_FILE=/etc/alertmanager/alertmanager.yml