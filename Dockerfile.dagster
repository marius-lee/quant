# Dockerfile for Quant Dagster
# 多阶段构建: builder -> runtime

# ===== Builder Stage =====
FROM python:3.12-slim AS builder

WORKDIR /opt/dagster

# 安装系统依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 复制依赖文件
COPY pyproject.toml requirements*.txt ./

# 安装 Python 依赖 (构建轮子)
RUN pip install --no-cache-dir --upgrade pip wheel setuptools && \
    pip wheel --no-cache-dir --wheel-dir /wheels -r requirements.txt 2>/dev/null || true

# 安装项目包
COPY quant/ ./quant/
RUN pip install --no-cache-dir -e ./quant

# ===== Runtime Stage =====
FROM python:3.12-slim AS runtime

WORKDIR /opt/dagster

# 安装运行时依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 创建非 root 用户
RUN groupadd -r dagster && useradd -r -g dagster -d /opt/dagster -s /bin/bash dagster

# 复制构建产物
COPY --from=builder /wheels /wheels
COPY --from=builder /opt/dagster/quant /opt/dagster/quant

# 安装预编译轮子
RUN pip install --no-cache-dir /wheels/* 2>/dev/null || true && \
    rm -rf /wheels

# 复制配置文件
COPY config.yaml /opt/dagster/config.yaml
COPY docker-compose.dagster.yml /opt/dagster/docker-compose.dagster.yml

# 设置权限
RUN chown -R dagster:dagster /opt/dagster

USER dagster

# 环境变量
ENV DAGSTER_HOME=/opt/dagster/dagster_home
ENV PYTHONPATH=/opt/dagster
ENV PYTHONUNBUFFERED=1

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:3000/healthcheck || exit 1

# 启动命令 (由 docker-compose 覆盖)
CMD ["dagster-webserver", "-h", "0.0.0.0", "-p", "3000"]

# 暴露端口
EXPOSE 3000